{
  "version": 1,
  "modernizationStage": 9,
  "principles": {
    "preserveExistingPublicPaths": true,
    "noCosmeticMoves": true,
    "newContentFollowsPolicy": true,
    "generatedOutputIsReproducible": true,
    "videosStayOutOfGitHistory": true
  },
  "content": {
    "postsRoot": "_posts",
    "postFilenamePattern": "YYYY-MM-DD-slug.md",
    "permalink": "/:year/:month/:day/:title.html",
    "rootPagesPolicy": "root-level-jekyll-pages-are-allowed"
  },
  "media": {
    "legacyUploadRoot": "assets/uploads",
    "futureArticleUploadRoot": "assets/uploads/articles",
    "futureArticleUploadPattern": "assets/uploads/articles/YYYY/MM/article-slug/",
    "generatedRoot": "assets/generated",
    "runtimeDataRoot": "assets/data",
    "videoBackend": "github-releases",
    "videoReleaseTagPattern": "writer-media-YYYY-MM",
    "generatedArticleRoot": "assets/generated/posts",
    "generatedArticlePattern": "assets/generated/posts/YYYY/MM/article-slug/",
    "sourceImageRole": "authored-source",
    "generatedImageRole": "rebuildable-derivative",
    "videoStorageRule": "release-assets-only"
  },
  "code": {
    "layoutsRoot": "_layouts",
    "includesRoot": "_includes",
    "jekyllDataRoot": "_data",
    "scriptsRoot": "scripts",
    "backendRoot": "_netlify-auth",
    "workflowsRoot": ".github/workflows",
    "writerSourceRoot": "_writer",
    "writerBundle": "assets/writer.js",
    "writerSourceModel": "ordered-build-time-concatenation",
    "writerBuildCommand": "npm run build:frontend",
    "scriptGroups": [
      "writer",
      "media",
      "matchmaker",
      "news",
      "history",
      "site-data",
      "qa"
    ],
    "siteDataGroups": [
      "events",
      "ufc",
      "live"
    ],
    "workflowFamilies": [
      "site",
      "writer",
      "matchmaker",
      "history",
      "events",
      "ufc",
      "live",
      "news",
      "publishing",
      "cms"
    ],
    "consolidatedWorkflows": {
      "writer": ".github/workflows/writer-quality.yml",
      "siteBrowser": ".github/workflows/site-browser-quality.yml",
      "matchmaker": ".github/workflows/update-matchmaker.yml"
    }
  },
  "protectedPaths": [
    "_config.yml",
    "_layouts/default.html",
    "index.html",
    "write.html",
    "assets/site.js",
    "assets/base.css",
    "assets/writer.js",
    "assets/writer.css",
    "assets/post-v3.css",
    "_netlify-auth/netlify/functions/writer-github.mjs"
  ],
  "legacyExceptions": {
    "existingUploadsRemainInPlace": true,
    "currentFlatScriptLayoutAllowedUntilStage": 5
  },
  "dataPolicyFile": ".repository-data-policy.json",
  "integrity": {
    "legacyMediaManifest": ".repository-legacy-media.json",
    "generatedAssetsManifest": ".repository-generated-assets.json",
    "maxTopLevelAssetImageBytes": 3145728,
    "articleUploadPattern": "assets/uploads/articles/YYYY/MM/article-slug/image.ext",
    "localArticleMediaMustExist": true,
    "duplicatePermalinksRejected": true,
    "versionedRootPagesRejected": true,
    "trackedVideosRejected": true
  }
}
