{% assign trusted_map = site.data.event_map_us %}
{% assign event_map_events = trusted_map.events %}
{
  "generated_at": {{ site.time | date_to_xmlschema | jsonify }},
  "major_total": {{ trusted_map.major_total | default: 0 | jsonify }},
  "major_loaded": {{ trusted_map.major_mapped | default: 0 | jsonify }},
  "regional_total": {{ trusted_map.regional_total | default: 0 | jsonify }},
  "regional_loaded": {{ trusted_map.regional_mapped | default: 0 | jsonify }},
  "quarantined_total": {{ trusted_map.quarantined_count | default: 0 | jsonify }},
  "event_overrides": {{ site.data.event_map_overrides | jsonify }},
  "events": {{ event_map_events | jsonify }}
}
